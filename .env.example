# AI Secretary 环境变量配置
# 复制本文件为 .env 并填入实际值
# 或直接在 docker-compose.yml 中设置

# === LLM 配置（必填）===
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=deepseek-chat

# === 认证配置（可选）===
# 不设置 = 无需 API Key 即可访问
# 单值 = ["your-api-key"]
# 多值 = ["key1","key2","key3"]
AUTH_API_KEYS=[]